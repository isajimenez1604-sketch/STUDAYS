{
  "expo": {
    "name": "STUDAYS",
    "slug": "STUDAYS",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/img/logo.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#004453",
        "foregroundImage": "./src/img/logotranslucent.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.juanjoj.STUDAYS"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-status-bar",
      "expo-font",
      "@react-native-community/datetimepicker",
      [
        "expo-notifications",
        {
          "defaultChannel": "planner-timer"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#004453",
          "image": "./src/img/logotranslucent.png",
          "imageWidth": 180,
          "resizeMode": "contain"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "d0978808-4cfc-47d9-9df3-c436b103ac5b"
      }
    },
    "owner": "juanjoj"
  }
}
